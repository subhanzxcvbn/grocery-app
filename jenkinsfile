@Library('jenkins-shared-library') _

node {
    stage('Code CheckOut') {
        checkoutcode(
            'https://github.com/subhanzxcvbn/grocery-app.git',
            'main'
         )
    }

    stage('Build Frontend') {
        buidImages('grocery-frontend:latest', 'frontend')
    }

    stage('build Backend') {
        buidImages('grocery-backend:latest', 'backend')

    }
    stage('Push to Docker Hub') {
        pushDocker(
            'grocery-frontend:latest',
            'grocery-frontend',
            'jenkinscred'
        )
    }
    stage('push to Docker hub') {
        pushDocker(
            'grocery-backend:latest',
            'grocery-backend',
            'jenkinscred'
        )
    }

    stage('Deploy') {
        deployDocker()
    }
}
