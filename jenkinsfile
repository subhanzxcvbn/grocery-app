
@Library('jenkins-shared-library') _

node {
    stage('Code CheckOut') {
        checkoutcode(
            'https://github.com/subhanzxcvbn/grocery-app.git',
            'main'
        )
    }

    stage('Build Frontend') {
        buidImages('grocery-frontend:latest', 'client')
    }

    stage('Build Backend') {
        buidImages('grocery-backend:latest', 'server')
    }

    stage('Push Frontend to Docker Hub') {
        pushDocker(
            'grocery-frontend:latest',
            'grocery-frontend',
            'jenkinscred'
        )
    }

    stage('Push Backend to Docker Hub') {
        pushDocker(
            'grocery-backend:latest',
            'grocery-backend',
            'jenkinscred'
        )
    }

    stage('Deploy') {
        withCredentials([
            file(credentialsId: 'grocery-env', variable: 'ENV_FILE')
        ]) {
            sh '''
                mkdir -p server
                install -m 600 "$ENV_FILE" server/.env
            '''

            try {
                deployDocker()
            } finally {
                sh 'rm -f server/.env'
            }
        }
    }
}
